rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Wallet-first posture:
    // - Blockchain remains economic truth
    // - Firestore serves product metadata only
    // - Public content is readable
    // - Writes stay admin-only until wallet-signature auth exists

    match /duels/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /submissions/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /app_config/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /wallet_profiles/{document=**} {
      allow read: if false;
      allow write: if false;
    }

    match /activity_logs/{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
